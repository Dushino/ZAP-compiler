{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zap",
  "scopeName": "source.zap",
  "patterns": [
    { "include": "#comments" },
    { "include": "#preprocessor" },
    { "include": "#keywords" },
    { "include": "#storage-types" },
    { "include": "#constants" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#directives" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.zap",
          "match": ";.*$"
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "keyword.control.preprocessor.zap",
          "match": "\\.(ifdef|ifndef|else|endif|define|undef|module|include|segment)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.zap",
          "match": "\\b(IF|THEN|ELSE|ELSEIF|FI|WHILE|DO|OD|FOR|TO|STEP|UNTIL|RETURN|EXIT)\\b"
        },
        {
          "name": "keyword.other.zap",
          "match": "\\b(PROC|FUNC|END)\\b"
        }
      ]
    },
    "storage-types": {
      "patterns": [
        {
          "name": "storage.type.zap",
          "match": "\\b(BYTE|WORD|CARD|INT|POINTER|ARRAY)\\b"
        },
        {
          "name": "storage.modifier.zap",
          "match": "\\b(CONST)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.zap",
          "match": "\\b(TRUE|FALSE)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.zap",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.zap",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.zap",
          "match": "\\$[0-9A-Fa-f]+"
        },
        {
          "name": "constant.numeric.decimal.zap",
          "match": "\\b[0-9]+"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.zap",
          "match": "\\+|-|\\*|/|MOD|&|\\||\\^|<<|>>"
        },
        {
          "name": "keyword.operator.comparison.zap",
          "match": "=|#|<|>|<=|>=|<>|AND|OR|NOT"
        },
        {
          "name": "keyword.operator.assignment.zap",
          "match": "="
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.zap",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.zap",
          "match": "\\.(segment)\\b"
        }
      ]
    }
  }
}
