source "https://rubygems.org"

# GitHub Pages gem — pins Jekyll + plugins to versions GitHub Pages supports.
# This lets you preview the site locally with the same software GitHub uses.
gem "github-pages", group: :jekyll_plugins

# just-the-docs theme (loaded via remote_theme in _config.yml for GitHub Pages,
# but also listed here so local `bundle exec jekyll serve` works.)
gem "just-the-docs"

# Windows and JRuby do not include zoneinfo files, so bundle the tzinfo-data gem
# and associated library.
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end

# Performance-booster for watching directories on Windows
gem "wdm", "~> 0.1.1", :platforms => [:mingw, :x64_mingw, :mswin]
