{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "source.zap.asm.injection",
  "injectionSelector": "source.zap",
  "patterns": [
    {
      "name": "meta.embedded.asm.ca65.zap",
      "begin": "^\\s*([Aa][Ss][Mm])\\b",
      "beginCaptures": {
        "1": { "name": "keyword.control.zap" }
      },
      "end": "^\\s*([Ee][Nn][Dd])\\b",
      "endCaptures": {
        "1": { "name": "keyword.control.zap" }
      },
      "patterns": [
        {
          "include": "source.ca65"
        }
      ]
    }
  ]
}
