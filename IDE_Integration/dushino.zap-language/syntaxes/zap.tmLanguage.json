{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Zap",
    "scopeName": "source.zap",
    "patterns": [
        {
            "include": "#proc-asm-block"
        },
        {
            "include": "#inline-asm-block"
        },
        {
            "include": "#comments"
        },
        {
            "include": "#attributes"
        },
        {
            "include": "#preprocessor"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#enum-block"
        },
        {
            "include": "#storage-types"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#directives"
        }
    ],
    "repository": {
        "proc-asm-block": {
            "comment": "proc/func #asm body — declaration header gets ZAP highlighting, body gets ca65 highlighting",
            "begin": "^(\\s*(?:[Pp][Rr][Oo][Cc]|[Ff][Uu][Nn][Cc])\\b[^\\n]*#[Aa][Ss][Mm]\\b[^\\n]*)$",
            "beginCaptures": {
                "1": {
                    "patterns": [
                        { "include": "#keywords" },
                        { "include": "#attributes" },
                        { "include": "#storage-types" },
                        { "include": "#numbers" }
                    ]
                }
            },
            "end": "^\\s*([Ee][Nn][Dd])\\b",
            "endCaptures": {
                "1": { "name": "keyword.control.zap" }
            },
            "patterns": [
                { "include": "source.ca65" }
            ]
        },
        "inline-asm-block": {
            "comment": "Inline asm...end block inside a proc/func body — body gets ca65 highlighting",
            "begin": "^(\\s*)([Aa][Ss][Mm])\\b",
            "beginCaptures": {
                "2": { "name": "keyword.control.zap" }
            },
            "end": "^\\s*([Ee][Nn][Dd])\\b",
            "endCaptures": {
                "1": { "name": "keyword.control.zap" }
            },
            "patterns": [
                { "include": "source.ca65" }
            ]
        },
        "attributes": {
            "patterns": [
                {
                    "name": "constant.other.zap",
                    "match": "#(?:[Pp][Oo][Rr][Tt]|[Rr][Dd]|[Ww][Rr]|[Kk][Ee][Ee][Pp]|[Ee][Xx][Pp][Oo][Rr][Tt]|[Nn][Oo][Ee][Xx][Pp][Oo][Rr][Tt]|[Aa][Ss][Mm])"
                },
                {
                    "name": "keyword.operator.address.zap",
                    "match": "@"
                }
            ]
        },
        "comments": {
            "patterns": [
                {
                    "name": "comment.block.zap",
                    "begin": "/\\*",
                    "end": "\\*/",
                    "patterns": [
                        {
                            "name": "comment.block.zap",
                            "match": "."
                        }
                    ]
                },
                {
                    "name": "comment.line.semicolon.zap",
                    "match": ";.*$"
                }
            ]
        },
        "preprocessor": {
            "patterns": [
                {
                    "name": "keyword.control.preprocessor.zap",
                    "match": "\\.(?:[Ii][Ff][Dd][Ee][Ff]|[Ii][Ff][Nn][Dd][Ee][Ff]|[Ee][Ll][Ss][Ee]|[Ee][Nn][Dd][Ii][Ff]|[Dd][Ee][Ff][Ii][Nn][Ee]|[Uu][Nn][Dd][Ee][Ff]|[Mm][Oo][Dd][Uu][Ll][Ee]|[Ii][Nn][Cc][Ll][Uu][Dd][Ee]|[Ee][Rr][Rr][Oo][Rr]|[Ww][Aa][Rr][Nn][Ii][Nn][Gg]|[Ii][Nn][Ff][Oo])\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.zap",
                    "match": "\\b(?:[Pp][Ee][Ee][Kk]|[Pp][Oo][Kk][Ee]|[Ll][Oo][Ww][Ww]|[Hh][Ii][Gg][Hh][Ww]|[Ll][Oo][Ww]|[Hh][Ii][Gg][Hh]|[Ss][Ii][Zz][Ee][Oo][Ff]|[Ii][Ff]|[Ee][Ll][Ss][Ee]|[Ee][Ll][Ss][Ee][Ii][Ff]|[Ss][Ww][Ii][Tt][Cc][Hh]|[Cc][Aa][Ss][Ee]|[Dd][Ee][Ff][Aa][Uu][Ll][Tt]|[Bb][Rr][Ee][Aa][Kk]|[Cc][Oo][Nn][Tt][Ii][Nn][Uu][Ee]|[Ww][Hh][Ii][Ll][Ee]|[Rr][Ee][Pp][Ee][Aa][Tt]|[Uu][Nn][Tt][Ii][Ll]|[Ff][Oo][Rr]|[Tt][Oo]|[Ss][Tt][Ee][Pp]|[Pp][Rr][Oo][Cc]|[Ff][Uu][Nn][Cc]|[Ee][Nn][Dd]|[Aa][Ss][Mm]|[Rr][Ee][Tt][Uu][Rr][Nn]|[Ee][Xx][Ii][Tt]|[Ss][Tt][Rr][Uu][Cc][Tt]|[Uu][Nn][Ii][Oo][Nn]|[Ee][Nn][Uu][Mm])\\b"
                },
                {
                    "name": "keyword.other.zap",
                    "match": "\\b(?:[Pp][Rr][Oo][Cc][Xx]|[Ff][Uu][Nn][Cc][Xx])\\b"
                }
            ]
        },
        "storage-types": {
            "patterns": [
                {
                    "name": "storage.type.zap",
                    "match": "\\b(?:[Bb][Yy][Tt][Ee]|[Ww][Oo][Rr][Dd]|[Ll][Oo][Nn][Gg])\\b"
                },
                {
                    "name": "storage.modifier.zap",
                    "match": "\\b(?:[Cc][Oo][Nn][Ss][Tt]|[Ss][Tt][Aa][Tt][Ii][Cc])\\b"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.zap",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.zap",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.zap",
                    "match": "\\$[0-9A-Fa-f]+"
                },
                {
                    "name": "constant.numeric.decimal.zap",
                    "match": "\\b[0-9]+"
                },
                {
                    "name": "constant.numeric.binary.zap",
                    "match": "\\%[0-1]+"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.arithmetic.zap",
                    "match": "\\+|-|\\*|/|%|&|\\||\\^|<<|>>"
                },
                {
                    "name": "keyword.operator.comparison.zap",
                    "match": "==|!=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.logical.zap",
                    "match": "&&|\\|\\||!"
                },
                {
                    "name": "keyword.operator.assignment.zap",
                    "match": "="
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "entity.name.function.zap",
                    "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()"
                }
            ]
        },
        "enum-block": {
            "begin": "^\\s*[Ee][Nn][Uu][Mm]\\b.*$",
            "beginCaptures": {
                "0": {
                    "name": "keyword.control.enum.zap"
                }
            },
            "end": "^\\s*[Ee][Nn][Dd]\\b",
            "endCaptures": {
                "0": {
                    "name": "keyword.control.end.zap"
                }
            },
            "name": "meta.block.enum.zap",
            "patterns": [
                {
                    "name": "entity.name.constant.enum.zap",
                    "match": "^[ \\t]*([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "entity.name.constant.enum.zap"
                        }
                    }
                },
                {
                    "name": "constant.numeric.zap",
                    "match": "\\$[0-9A-Fa-f]+|\\b[0-9]+\\b"
                },
                {
                    "name": "keyword.operator.assignment.zap",
                    "match": "="
                }
            ]
        }
    }
}