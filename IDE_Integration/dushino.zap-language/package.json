{
    "name": "zap-language",
    "displayName": "Zap language support",
    "description": "Syntax highlighting and icons for the Zap programming language",
    "icon": "icons/icon.png",
    "version": "1.0.0",
    "publisher": "dushino",
    "repository": {
        "type": "git",
        "url": "https://github.com/Dushino/ZAP-compiler"
    },
    "bugs": {
        "url": "https://github.com/Dushino/ZAP-compiler/issues"
    },
    "keywords": [
        "Zap",
        "Assembly",
        "6502",
        "65c02",
        "ca65",
        "language"
    ],
    "main": "./extension.js",
    "engines": {
        "vscode": "^1.70.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "zap",
                "aliases": [
                    "ZAP",
                    "Zap",
                    "zap"
                ],
                "extensions": [
                    ".zap"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./icons/zap-icon-light.svg",
                    "dark": "./icons/zap-icon-dark.svg"
                }
            }
        ],
        "configurationDefaults": {
            "[zap]": {
                "editor.colorDecorators": false
            },
            "[asm]": {
                "editor.colorDecorators": false
            }
        },
        "grammars": [
            {
                "language": "zap",
                "scopeName": "source.zap",
                "path": "./syntaxes/zap.tmLanguage.json"
            },
            {
                "scopeName": "source.ca65",
                "path": "./syntaxes/ca65.tmLanguage.json"
            },
            {
                "scopeName": "source.zap.asm.injection",
                "path": "./syntaxes/zap-ca65.injection.json",
                "injectTo": [
                    "source.zap"
                ]
            }
        ],
        "snippets": [
            {
                "language": "zap",
                "path": "./snippets/zap.json"
            }
        ],
        "taskDefinitions": [
            {
                "type": "zap"
            }
        ],
        "problemMatchers": [
            {
                "name": "zap-matcher",
                "owner": "zap",
                "label": "ZAP Compiler Errors",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^\\s*([^\\s].*\\.[zZ][aA][pP]):(\\d+):(\\d+):\\s+(error|warning|info):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        ],
        "configuration": {
            "title": "ZAP Language",
            "properties": {
                "zap.ai.enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable AI inline code suggestions for ZAP files"
                },
                "zap.ai.provider": {
                    "type": "string",
                    "enum": ["anthropic", "openai"],
                    "default": "anthropic",
                    "description": "AI provider to use for code suggestions"
                },
                "zap.ai.apiKey": {
                    "type": "string",
                    "default": "",
                    "description": "API key for the selected AI provider"
                },
                "zap.ai.model": {
                    "type": "string",
                    "default": "claude-sonnet-4-6-20250514",
                    "description": "Model name to use for completions"
                },
                "zap.ai.endpoint": {
                    "type": "string",
                    "default": "",
                    "description": "Custom API endpoint URL (leave empty for default). Use for proxies or local models (e.g. Ollama)"
                },
                "zap.ai.maxTokens": {
                    "type": "number",
                    "default": 256,
                    "minimum": 32,
                    "maximum": 2048,
                    "description": "Maximum tokens per completion response"
                },
                "zap.ai.debounceMs": {
                    "type": "number",
                    "default": 500,
                    "minimum": 200,
                    "maximum": 5000,
                    "description": "Debounce delay in milliseconds before requesting a completion"
                }
            }
        },
        "commands": [
            {
                "command": "zap.runBuild",
                "title": "ZAP: Compile current file",
                "category": "Build"
            },
            {
                "command": "zap.compile",
                "title": "ZAP: Quick Compile",
                "category": "Build"
            },
            {
                "command": "zap.aiToggle",
                "title": "ZAP: Toggle AI Completions"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "zap.runBuild",
                    "when": "editorLangId == zap"
                },
                {
                    "command": "zap.compile",
                    "when": "editorLangId == zap"
                }
            ],
            "editor/context": [
                {
                    "command": "zap.runBuild",
                    "when": "editorLangId == zap",
                    "group": "navigation"
                }
            ],
            "explorer/context": [
                {
                    "command": "zap.runBuild",
                    "when": "resourceExtname == .zap",
                    "group": "navigation"
                }
            ]
        },
        "keybindings": [
            {
                "key": "ctrl+shift+z",
                "command": "zap.compile",
                "when": "editorTextFocus && editorLangId == zap"
            },
            {
                "key": "ctrl+alt+z",
                "command": "workbench.action.tasks.runTask",
                "args": "zap: Build ZAP project"
            }
        ]
    },
    "activationEvents": [
        "onFile:*.zap"
    ]
}