{
    "brackets": [        
        [
            "[",
            "]"
        ],
        [
            "(",
            ")"
        ],
        [
            "{",
            "}"
        ]
    ],
    "autoClosingPairs": [
        {
            "open": "{",
            "close": "}"
        },
        {
            "open": "[",
            "close": "]"
        },
        {
            "open": "(",
            "close": ")"
        },
        {
            "open": "'",
            "close": "'"
        },
        {
            "open": "\"",
            "close": "\"",
            "notIn": [
                "string"
            ]
        },
        {
            "open": "/*",
            "close": "*/"
        }
    ],
    "surroundingPairs": [
        [
            "{",
            "}"
        ],
        [
            "[",
            "]"
        ],
        [
            "(",
            ")"
        ],
        [
            "\"",
            "\""
        ],
        [
            "'",
            "'"
        ]
    ],
    "folding": {
        "markers": {
            "start": "(?i)^\\s*(PROC|FUNC|IF|ELSE|ELSEIF|SWITCH|CASE|WHILE|ASM|STRUCT|ENUM|\\.ifdef|\\.ifndef|\\.else)",
            "end": "(?i)^\\s*(RETURN|END|BREAK|\\.endif|\\.else)"
        },
        "offSide": false
    }
}
