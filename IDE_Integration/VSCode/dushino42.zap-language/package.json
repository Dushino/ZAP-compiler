{
  "name": "zap-language",
  "displayName": "Zap Language Support",
  "description": "Syntax highlighting and icons for the Zap programming language",
  "version": "1.0.0",
  "publisher": "dushino42",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "icons/zap-icon-light.svg",
  "contributes": {
    "languages": [
      {
        "id": "zap",
        "aliases": [
          "Zap",
          "zap"
        ],
        "extensions": [
          ".zap"
        ],
        "icon": {
          "light": "./icons/zap-icon-light.svg",
          "dark": "./icons/zap-icon-dark.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zap",
        "scopeName": "source.zap",
        "path": "./syntaxes/zap.tmLanguage.json"
      }
    ]
  }
}
