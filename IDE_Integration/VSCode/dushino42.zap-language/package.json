{
    "name": "zap-language",
    "displayName": "Zap language support",
    "description": "Syntax highlighting and icons for the Zap programming language",
    "icon": "icons/icon.png",
    "version": "1.0.0",
    "publisher": "dushino42",
    "main": "./extension.js",
    "engines": {
        "vscode": "^1.70.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "zap",
                "aliases": [
                    "ZAP",
                    "Zap",
                    "zap"
                ],
                "extensions": [
                    ".zap"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./icons/zap-icon-light.svg",
                    "dark": "./icons/zap-icon-dark.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "zap",
                "scopeName": "source.zap",
                "path": "./syntaxes/zap.tmLanguage.json"
            },
            {
                "scopeName": "source.ca65",
                "path": "./syntaxes/ca65.tmLanguage.json"
            },
            {
                "scopeName": "source.zap.asm.injection",
                "path": "./syntaxes/zap-ca65.injection.json",
                "injectTo": [
                    "source.zap"
                ]
            }
        ],
        "taskDefinitions": [
            {
                "type": "zap"
            }
        ],
        "problemMatchers": [
            {
                "name": "zap-matcher",
                "owner": "zap",
                "label": "ZAP Compiler Errors",
                "pattern": {
                    "regexp": "^([^\\s].*):(\\d+):(\\d+):\\s+(error|warning|info):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        ],

        "commands": [
            {
                "command": "zap.runBuild",
                "title": "ZAP: Compile current file",
                "category": "Build"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "zap.runBuild",
                    "when": "editorLangId == zap"
                }
            ]
        }
    },
    "activationEvents": [
        "onLanguage:zap"
    ]
}
