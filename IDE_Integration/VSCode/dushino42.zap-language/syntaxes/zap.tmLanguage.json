{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Zap",
    "scopeName": "source.zap",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#attributes"
        }, 
        {
            "include": "#preprocessor"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#enum-block"
        },
        {
            "include": "#storage-types"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#directives"
        }
    ],
    "repository": {
        "attributes": {
            "patterns": [
                {
                    "name": "constant.other.zap",
                    "match": "#(?i)(PORT|RD|WR|KEEP|EXPORT|NOEXPORT)"
                },
                {
                    "name": "keyword.operator.address.zap",
                    "match": "@"
                }
            ]
        },        
        "comments": {
            "patterns": [
                {
                    "name": "comment.block.zap",
                    "begin": "/\\*",
                    "end": "\\*/",
                    "patterns": [
                        {
                            "name": "comment.block.zap",
                            "match": "."
                        }
                    ]
                },
                {
                    "name": "comment.line.semicolon.zap",
                    "match": ";.*$"
                }
            ]
        },
        "preprocessor": {
            "patterns": [
                {
                    "name": "keyword.control.preprocessor.zap",
                    "match": "(?i)\\.(ifdef|ifndef|else|endif|define|undef|module|include|error|warning|info)\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.zap",
                    "match": "(?i)\\b(IF|THEN|ELSE|ELSEIF|ENDIF|SWITCH|CASE|BREAK|WHILE|FOR|TO|STEP|WHILE|PROC|FUNC|END|ASM|RETURN|EXIT|STRUCT|ENUM)\\b"
                },
                {
                    "name": "keyword.other.zap",
                    "match": "(?i)\\b(PROCx|FUNCx)\\b"
                }
            ]
        },
        "storage-types": {
            "patterns": [
                {
                    "name": "storage.type.zap",
                    "match": "(?i)\\b(BYTE|WORD)\\b"
                },
                {
                    "name": "storage.modifier.zap",
                    "match": "(?i)\\b(CONST|STATIC)\\b"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.zap",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.zap",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.zap",
                    "match": "\\$[0-9A-Fa-f]+"
                },
                {
                    "name": "constant.numeric.decimal.zap",
                    "match": "\\b[0-9]+"
                },
                {
                    "name": "constant.numeric.binary.zap",
                    "match": "\\%[0-1]+"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.arithmetic.zap",
                    "match": "(?i)\\+|-|\\*|/|%|&|\\||\\^|<<|>>"
                },
                {
                    "name": "keyword.operator.comparison.zap",
                    "match": "(?i)=|<|>|<=|>=|<>"
                },
                {
                    "name": "keyword.operator.assignment.zap",
                    "match": "="
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "entity.name.function.zap",
                    "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()"
                }
            ]
        },
        "enum-block": {
            "begin": "(?i)^\\s*enum\\b.*$",
            "beginCaptures": {
                "0": { "name": "keyword.control.enum.zap" }
            },
            "end": "(?i)^\\s*END\\b",
            "endCaptures": {
                "0": { "name": "keyword.control.end.zap" }
            },
            "name": "meta.block.enum.zap",
            "patterns": [
                {
                    "name": "entity.name.constant.enum.zap",
                    "match": "^[ \\t]*([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "entity.name.constant.enum.zap" }
                    }
                },
                {
                    "name": "constant.numeric.zap",
                    "match": "\\$[0-9A-Fa-f]+|\\b[0-9]+\\b"
                },
                {
                    "name": "keyword.operator.assignment.zap",
                    "match": "="
                }
            ]
        }
    }
}
