{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "source.zap.asm.injection",
  "injectionSelector": "source.zap",
  "patterns": [
    {
      "name": "meta.embedded.asm.ca65.zap",
