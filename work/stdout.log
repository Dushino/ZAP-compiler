; ------------------------------
; Array copy routine (__ARRCPY)
; Inputs: __TMP0/__TMP0+1=src addr, __TMP2/__TMP2+1=dst addr, A=length
; Copies exactly A bytes regardless of content
; Clobbers: A, X, Y
; ------------------------------
__ARRCPY:
	STA __TMP3
	LDX #$00
	LDY #$00
ARRCPY_LOOP:
	CPX __TMP3
	BEQ ARRCPY_DONE
	LDA (__TMP0),Y
	STA (__TMP2),Y
	INX
	INY
	BNE ARRCPY_LOOP
ARRCPY_DONE:
	RTS
