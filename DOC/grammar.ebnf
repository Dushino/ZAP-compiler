(* ZAP! Language Grammar - EBNF Notation *)
(* Updated: January 2026 - Struct Support, Bitwise Operators, Const Structs, PORT Modifier, STATIC Variables, LONG (32-bit) Type *)
(* Lexical tokens: IDENT, NUMBER, STRING, DECLMOD, ASM_BLOCK *)
(*
   Enums: compile-time-only named integer constants. Default base type is `byte` unless a `word` is specified before the enum name.
   Example (END-style):
   enum byte Flags
       FLAG_A = 1
       FLAG_B = 2
   END
*)
(* Comments: beginning with ; until end of line *)

program         ::= { top_level } ;

top_level       ::= declaration
                  | proc_decl
                  | func_decl
                  | struct_decl
                  | enum_decl
                  | module_decl
                  | include_decl ;

enum_decl       ::= "enum" [ type ] IDENT enum_body "END" ;
enum_body       ::= { enum_item [ "," ] } ;
enum_item       ::= IDENT [ "=" expression ] ;

module_decl     ::= ".module" STRING [ decl_modifiers ] ;
include_decl    ::= ".include" STRING ;

(* ============ TYPES ============ *)
type            ::= base_type [ "^" ] ;

base_type       ::= "byte" | "word" | "long" | STRUCT_NAME ;

(* ============ DECLARATIONS ============ *)
declaration     ::= [ type_modifier { type_modifier } ] type declarator_list [ decl_modifiers ] ;

type_modifier   ::= "const" | "static" | "port" ;

decl_modifiers  ::= { decl_modifier } ;
decl_modifier   ::= "#KEEP" | "#NOEXPORT" | "#EXPORT" | "#PORT" | "#RD" | "#WR" ;

declarator_list ::= declarator { "," declarator } ;

declarator      ::= IDENT
                    [ array_spec ]
                    [ address_spec ]
                    [ initializer ] ;

array_spec      ::= "[" [ NUMBER ] "]" ;
address_spec    ::= "@" NUMBER ;               (* NUMBER may be decimal, $hex, 0xhex, 0b... *)

initializer     ::= "=" expression             (* scalar init *)
                  | "=" STRING                 (* byte[] string init, NUL-terminated *)
                  | "=" array_init ;           (* list init for arrays and structs *)

array_init      ::= "{" [ init_list ] "}" ;
init_list       ::= expression { "," expression } ;

(* ============ STRUCT DEFINITIONS ============ *)
struct_decl     ::= "struct" IDENT struct_body "end" ;
struct_body     ::= { struct_field } ;
struct_field    ::= type IDENT [ array_spec ] [ address_spec ] ;

(* ============ PROCEDURES ============ *)
proc_decl       ::= "proc" IDENT "(" [ param_list ] ")" [ decl_modifiers ] proc_body "end" ;

proc_body       ::= { local_decl } { statement } ;

(* ============ FUNCTIONS ============ *)
func_decl       ::= "func" type IDENT "(" [ param_list ] ")" [ decl_modifiers ] func_body "end" ;

func_body       ::= { local_decl } { statement } "return" expression ;

(* ============ PARAMETERS ============ *)
param_list      ::= param { "," param } ;
param           ::= type IDENT ;

(* ============ STATEMENTS ============ *)
local_decl      ::= [ type_modifier { type_modifier } ] type declarator_list ;

statement       ::= assignment
                  | call_stmt
                  | if_stmt
                  | while_stmt
                  | repeat_stmt
                  | for_stmt
                  | break_stmt
                  | continue_stmt
                  | return_stmt
                  | asm_stmt
                  | expr_stmt ;

assignment      ::= lvalue "=" expression
                  | lvalue compound_op expression ;

compound_op     ::= "+=" | "-=" | "*=" | "/=" | "%="
                  | "&=" | "|=" | "^=" | "<<=" | ">>=" ;

call_stmt       ::= IDENT "(" [ expr_list ] ")" ;

if_stmt         ::= "if" expression { statement }
                    { "elseif" expression { statement } }
                    [ "else" { statement } ]
                    "end" ;

while_stmt      ::= "while" expression { statement } "end" ;

repeat_stmt     ::= "repeat" { statement } "until" expression ;

for_stmt        ::= "for" IDENT "=" expression "to" expression
                    [ "step" expression ]
                    { statement }
                    "next" IDENT ;

break_stmt      ::= "break" ;

continue_stmt   ::= "continue" ;

return_stmt     ::= "return" [ expression ] ;

asm_stmt        ::= "asm" ASM_BLOCK "end" ;

expr_stmt       ::= expression ;

(* ============ L-VALUES ============ *)
lvalue          ::= IDENT
                  | IDENT "^"
                  | IDENT "[" expression "]"
                  | IDENT "." IDENT
                  | IDENT "^" "." IDENT ;     (* deref + field access *)

(* ============ EXPRESSIONS ============ *)
(* Operator precedence (lowest to highest):
   1. ||  (logical OR)
   2. &&  (logical AND)
   3. ==, !=
   4. <, >, <=, >=
   5. |   (bitwise OR)
   6. ^   (bitwise XOR)
   7. &   (bitwise AND)
   8. +, -
   9. *, /, %
   10. -, !, ~, @  (unary)
   11. primary (highest)
*)

expression      ::= logical_or ;

logical_or      ::= logical_and { "||" logical_and } ;

logical_and     ::= bitwise_or { "&&" bitwise_or } ;

bitwise_or      ::= bitwise_xor { "|" bitwise_xor } ;

bitwise_xor     ::= bitwise_and { "^" bitwise_and } ;

bitwise_and     ::= equality { "&" equality } ;

equality        ::= comparison { ("==" | "!=") comparison } ;

comparison      ::= term { ("<" | ">" | "<=" | ">=") term } ;

term            ::= factor { ("+" | "-") factor } ;

factor          ::= unary { ("*" | "/" | "%") unary } ;

unary           ::= [ "-" | "!" | "~" | "@" ] primary ;

primary         ::= NUMBER                      (* decimal, $hex (0x..), binary (%...) *)
                  | STRING                      (* "..." string literal *)
                  | IDENT
                  | IDENT "(" [ expr_list ] ")" (* function call *)
                  | IDENT "[" expression "]"    (* array subscript *)
                  | IDENT "." IDENT              (* struct field access *)
                  | IDENT "^"                   (* pointer dereference *)
                  | IDENT "^" "." IDENT        (* deref + field access *)
                  | "{" [ init_list ] "}"        (* struct literal *)
                  | "(" expression ")" ;

expr_list       ::= expression { "," expression } ;

(* ============ LEXICAL ELEMENTS ============ *)
(* 
   IDENT           - Starts with a-z A-Z, followed by a-z A-Z 0-9 _
   NUMBER          - Decimal: 0-9+, Hex: $0-9A-F or 0x0-9A-F, Binary: %0-1 or 0b0-1
                     Character literals 'x' are converted to numeric values during tokenization
   STRING          - "..." with NUL terminator, supports escape sequences
   ASM_BLOCK       - Inline 6502 assembly code
   Comments        - ; until end of line

   Escape Sequences in strings and character literals:
   - Standard: \n (newline), \t (tab), \r (carriage return), \a (bell), \b (backspace), 
              \f (form feed), \v (vertical tab), \0 (null), \" (double quote), \' (single quote), \\ (backslash)
   - Hexadecimal: \xHH where H is hex digit (0-9, a-f, A-F), e.g., \xFF, \x41
   - Octal: \OOO where O is octal digit (0-7), e.g., \377 (255), \101 (65/'A')
   - Binary: \bBBBBBBBB where B is binary digit (0-1), e.g., \b11111111 (255), \b01000001 (65/'A')
*)

(* ============ NOTES ============ *)
(*
   LONG Type:
   - 32-bit unsigned integer type (0–4 294 967 295)
   - Valid wherever byte or word is used: variables, parameters, return types, expressions, control flow
   - FOR loop variable, bounds, and step may all be long
   - SWITCH expression and CASE values may be long (multi-byte comparison generated)
   - Truthiness in IF/WHILE/REPEAT: all four bytes are OR-ed; result is non-zero if any byte is non-zero

   Type Modifiers:
   - CONST: Compile-time constant values (all types: byte, word, long, pointers, arrays, structs)
   - STATIC: Local variables that retain value between procedure calls (locals only)
   - PORT: Hardware port-mapped variables (globals only, requires @ address, no init)
   
   Type Modifier Rules:
   - Can be combined: CONST and STATIC cannot be used together
   - STATIC requires initializer and @ address specification (local variables only)
   - PORT requires @ address, no initializer, cannot be on arrays or pointers
   - Cannot combine CONST with STATIC
   - Cannot combine CONST with PORT
   - Cannot combine STATIC with PORT

   General Notes:
   - All identifiers are case-insensitive internally (converted to uppercase)
   - String literals preserve case
   - Character literals ('x') are converted to numeric values at tokenization time
   - Pointer types use ^ operator (e.g., byte ^ptr)
   - Fixed-address variables use @ specifier in declaration (e.g., byte x @$2000)
   - ADDRESS-OF operator: @ prefix in expressions gets variable address (e.g., @var, @array[i], @struct.field)
   - Procedures end with END, functions end with END (implicit return)
   - FOR loops require NEXT statement with loop variable
   - WHILE loops terminate with END
   - Binary \b escape sequences must have at least one binary digit following
   - IF statements use IF-ELSEIF-ELSE-END structure (ELSEIF/ELSE optional)
   - Module system: .module marks a file as importable, .include loads dependencies
   - ASM blocks embed raw 6502 assembly code; ca65 directives like .segment are only valid inside ASM...END blocks
   - STRUCT types: Composite types with named fields of various types
   - STRUCT INITIALIZATION: { value1, value2, ... } for creating struct instances
   - CONST STRUCTS: const <struct_type> name = { init_values } prevents modification
   - CONST STRUCT FIELDS: Cannot assign to fields of const structs at runtime
   - CONST SUPPORT: All types (byte, word, pointers, arrays, structs) support const initialization
   - BITWISE OPERATORS: & (AND), | (OR), ^ (XOR) for bit manipulation
   - STRUCT ARRAYS: Arrays of structs with full initialization and field access support
   - COMPOUND ASSIGNMENT: lhs op= expr is syntax sugar for lhs = lhs op expr (all arithmetic and bitwise ops)
   - STATIC VARIABLES: Local variables that persist across procedure calls
   - PORT VARIABLES: Hardware port-mapped variables (e.g., PORT byte POKEY_AUDF1 @$D200)
   - DECLARATION MODIFIERS: Trailing modifiers may be attached to top-level declarations, procedures, and functions. Supported modifiers include `#KEEP` (prevent dead-code elimination), `#NOEXPORT` (do not export from a module), `#EXPORT` (force export from non-module file), and `#PORT` / `#RD` / `#WR` (port-related modifiers). Modifiers may be combined and are case-insensitive.
   - ELSEIF SUPPORT: Multiple conditional branches (if-elseif-elseif-else-endif)
   - CONTINUE STATEMENT: Skip to next loop iteration in for/while loops
   - STRUCT FIELD ASSIGNMENT: Can assign to struct fields (unless const)
   - POINTER DEREFERENCING: Both IDENT^ and @IDENT ^ IDENT syntax supported
*)





